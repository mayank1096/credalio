    "sug02": {
      "x": 0,
      "y": 3244,
      "w": 1440,
      "maxH": 300,
      "text": "I’d drop the line “When you’re ready to publish, we’ll ask you to confirm it’s you. Not before.” It’s a lot to take in this early, and we explain it later in Readiness anyway.",
      "fill": "orange",
      "size": "s"
