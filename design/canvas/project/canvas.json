      "fill": "orange",
      "size": "s"
    },
    "sug07": {
      "x": 10350,
      "y": 12844,
      "w": 1440,
      "maxH": 140,
      "text": "The “What happens next” card and the line under the heading say pretty much the same thing. Shall we keep just one? I’d lean towards the card, with the line shortened to “We’ll notify you when it’s done.”",
      "fill": "orange",
      "size": "s"
    },
