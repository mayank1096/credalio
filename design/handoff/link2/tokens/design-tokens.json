{
  "color": {
    "text":        { "primary": "#0B1433", "body": "#3A4566", "secondary": "#4A5578", "muted": "#5B6582", "faded": "#8A93AD", "inverse": "#FFFFFF" },
    "accent":      { "default": "#1652F0", "hover": "#0E3BB8", "soft": "#EAF0FF", "softer": "#F5F8FF", "ring": "rgba(22, 82, 240, 0.12)" },
    "surface":     { "page": "#FFFFFF", "app": "#F7F9FD", "card": "#FFFFFF", "subtle": "#F1F3F8" },
    "border":      { "default": "#E6EAF3", "strong": "#D6DDEE", "stronger": "#CBD3E6", "divider": "#EEF1F7" },
    "status": {
      "success":   { "text": "#0F6B45", "bg": "#E7F5EE" },
      "progress":  { "text": "#1652F0", "bg": "#EAF0FF" },
      "warning":   { "text": "#8A5300", "bg": "#FFF3E0" },
      "neutral":   { "text": "#4A5578", "bg": "#F1F3F8" },
      "error":     { "text": "#B42318", "border": "#D92D20" }
    },
    "creio":       { "bgFrom": "#FFF1CF", "bgTo": "#FFFAEB", "border": "#F4D98E", "text": "#4A3300", "coin": "#F6C343" }
  },
  "font": {
    "family": "'Google Sans', 'Google Sans Text', 'Helvetica Neue', system-ui, sans-serif",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "size": {
      "h1Onboarding": "clamp(34px, 5.4vh, 46px)", "h1Page": "clamp(30px, 4.6vh, 40px)", "h1Mobile": "25px",
      "lead": "17.5px", "body": "15px", "small": "13.5px", "label": "13px", "button": "15.5px"
    },
    "letterSpacing": { "h1": "-0.03em", "tight": "-0.005em" },
    "lineHeight": { "heading": 1.12, "body": 1.6 }
  },
  "radius": { "xs": "4px", "sm": "12px", "chip": "14px", "card": "18px", "cardLarge": "22px", "pill": "999px" },
  "border": { "width": "1.5px" },
  "shadow": {
    "card": "0 1px 2px rgba(11, 20, 51, 0.03)",
