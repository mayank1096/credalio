    "dialog": "0 24px 64px rgba(11, 20, 51, 0.18)",
    "buttonPrimary": "0 1px 0 rgba(255, 255, 255, 0.25) inset, 0 10px 24px rgba(22, 82, 240, 0.24)",
    "selected": "0 0 0 4px rgba(22, 82, 240, 0.12)",
    "focus": "0 0 0 3px rgba(22, 82, 240, 0.45)"
  },
  "size": { "touchTarget": "44px", "buttonHeight": "52px", "buttonHeightMobile": "48px", "sidebar": "264px", "topBar": "64px", "topBarMobile": "56px", "readingColumn": "720px" },
  "breakpoint": { "tablet": "1080px", "mobile": "960px", "small": "760px" },
  "motion": {
    "ease": "ease", "spring": "cubic-bezier(.3, 1.4, .5, 1)", "out": "cubic-bezier(.2, .8, .2, 1)",
    "fast": "0.2s", "enter": "0.5s", "stagger": "0.08s",
    "reducedMotion": "every animation is switched off under prefers-reduced-motion"
  }
